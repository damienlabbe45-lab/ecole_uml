        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n:essais = 0;\n\nrepeat\n  :Saisir identifiants de connexion;\n  :Vérifier l&#39;authentification;\n  \n  if (Identifiants corrects ?) then (Oui)\n    break\n  else (Non)\n    :essais = essais + 1;\n    :Afficher message d&#39;erreur;\n  endif\nrepeat while (essais &lt; 3) is (Oui)\n\nif (essais &gt;= 3) then (Oui)\n  :Afficher \&quot;Compte temporairement bloqué\&quot;;\n  stop\nendif\n\n:Authentification réussie;\n\nrepeat\n  switch (Rôle de l&#39;utilisateur ?)\n  case ( Élève )\n    :Afficher les cours;\n  case ( Professeur )\n    :Donner cours / Afficher élèves;\n  case ( Directeur )\n    :Gestion des cours / Gestion des comptes;\n  case ( Administrateur )\n    :Créer un compte directeur;\n  endswitch\n\nrepeat while (Souhaite effectuer une autre action ?) is (Oui)\n\n:Se déconnecter;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="sBzxM-PS0f9o2RdFFJ3_-1">
