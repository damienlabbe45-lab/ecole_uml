        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n\nif (Etre sur l&#39;application ?) then (oui)\n  :essais = 0;\n\n  repeat\n    :Saisir login et\n    mot de passe\n    de connexion;\n    :Vérifier\n    l&#39;authentification;\n    \n    if (Identifiants corrects ?) then (Oui)\n      break\n    else (Non)\n      :essais = essais + 1;\n      :Afficher\n      message d&#39;erreur;\n    endif\n  repeat while (essais &lt; 3) is (Oui) not (Non)\n\n  if (essais &gt;= 3) then (Oui)\n    :Afficher\n    \&quot;Compte temporairement bloqué\&quot;;\n    :Notifier\n    à l&#39;administrateur;\n    :Enregistrer\n    la tentative dans le journal;\n  else (Non)\n    :Authentification\n    réussie;\n\n    repeat\n      switch (Rôle de l&#39;utilisateur ?)\n      case ( Élève )\n        :Afficher\n        les cours;\n      case ( Professeur )\n        switch (Quelle action effectuer ?)\n        case ( Action 1 )\n          :Afficher\n          les cours;\n        case ( Action 2 )\n          :Afficher\n          les élèves;\n        case ( Action 3 )\n          :Donner\n           cours;\n        case ( Action 4 )\n          :Afficher \n          répartition\n          géographique\n          des élèves;\n        endswitch\n      case ( Directeur )\n        switch (Quelle action effectuer ?)\n        case ( Action 1 )\n          :Afficher\n          les cours;\n        case ( Action 2 )\n          :Afficher\n          les élèves;\n        case ( Action 3 )\n          :Donner\n          cours;\n        case ( Action 4 )\n          :Gestion\n          des cours;\n        case ( Action 5 )\n          :Gestio\n           des comptes;\n        case ( Action 6 )\n          :Afficher\n          répartition\n          géographique\n          des élèves;\n        endswitch\n      case ( Administrateur )\n        switch (Quelle action effectuer ?)\n        case ( Action 1 )\n          :Créer\n          compte directeur;\n        case ( Action 2 )\n          :Gestion\n          des comptes;\n        endswitch\n      endswitch\n    repeat while (Souhaitez vous \n    effectuer\n    une autre action ?) is (Oui)\n\n    :Se déconnecter;\n  endif\n\nelse (Non)\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9-sisFH6Vv7h1RGsOse7-0">
